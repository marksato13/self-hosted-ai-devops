# Codex CLI a través de LiteLLM. No contiene credenciales.
# La clave local se lee desde el archivo litellm_master_key.

model = "coding"
model_provider = "litellm"
approval_policy = "on-request"
sandbox_mode = "workspace-write"

[model_providers.litellm]
name = "LiteLLM local"
base_url = "http://localhost:4000/v1"
env_key = "LITELLM_MASTER_KEY"
requires_openai_auth = false
wire_api = "responses"

# Codex 0.146+ carga cada perfil desde ~/.codex/<perfil>.config.toml.
# Las plantillas correspondientes están en config/codex-profiles/.
