# Codex CLI a través de OmniRoute. No contiene credenciales.
# La clave local se lee de OMNIROUTE_API_KEY.

model = "auto/coding"
model_provider = "omniroute"
approval_policy = "on-request"
sandbox_mode = "workspace-write"

[model_providers.omniroute]
name = "OmniRoute local"
base_url = "http://localhost:20128/v1"
env_key = "OMNIROUTE_API_KEY"
requires_openai_auth = false
wire_api = "responses"

# Codex 0.146+ carga cada perfil desde ~/.codex/<perfil>.config.toml.
# Las plantillas correspondientes están en config/codex-profiles/.
