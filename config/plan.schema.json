{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["resumen", "subtareas"],
  "properties": {
    "resumen": { "type": "string", "minLength": 1 },
    "subtareas": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["agente", "descripcion", "criterio_aceptacion"],
        "properties": {
          "agente": { "enum": ["backend", "tests", "docs"] },
          "descripcion": { "type": "string", "minLength": 1 },
          "criterio_aceptacion": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
