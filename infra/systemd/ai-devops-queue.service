[Unit]
Description=Procesador de issues de la flota de IA
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/self-hosted-ai-devops
ExecStart=%h/self-hosted-ai-devops/scripts/procesar-cola.sh
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/workspace %h/.local/state/ai-devops %h/self-hosted-ai-devops

[Install]
WantedBy=multi-user.target
