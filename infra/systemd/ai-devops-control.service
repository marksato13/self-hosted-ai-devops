[Unit]
Description=Procesa órdenes cerradas de control de la flota
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/self-hosted-ai-devops
Environment="PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin"
Environment="AI_SECRETS_DIR=%h/.config/ai-devops/secrets"
ExecStart=%h/self-hosted-ai-devops/scripts/procesar-control.sh
Nice=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/workspace %h/.local/state/ai-devops %h/self-hosted-ai-devops

[Install]
WantedBy=default.target
