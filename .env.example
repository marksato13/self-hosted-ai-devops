# Configuración no secreta. Copiar a .env con chmod 600.
# Las claves viven en $AI_SECRETS_DIR, un archivo por secreto con chmod 600.
# Inicializa el directorio con ./scripts/preparar-secretos.sh.

# ---------- Control Telegram ----------
# Token: $AI_SECRETS_DIR/telegram_bot_token
TELEGRAM_ALLOWED_CHAT_IDS=
AI_QUEUE_DIR=/home/CAMBIAR/.local/state/ai-devops/queue
AI_STATE_DIR=/home/CAMBIAR/.local/state/ai-devops
AI_SECRETS_DIR=/home/CAMBIAR/.config/ai-devops/secrets
TZ=America/Bogota

# ---------- GitHub App ----------
# Crea una GitHub App instalada SOLAMENTE en el repositorio objetivo.
# Private key PEM: $AI_SECRETS_DIR/github_app_private_key
GITHUB_APP_ID=
GITHUB_OWNER=marksato13
GITHUB_REPO=self-hosted-ai-devops
AI_TARGET_REPO_DIR=/home/CAMBIAR/workspace/PROYECTO-OBJETIVO

# ---------- LiteLLM ----------
# Clave maestra generada: $AI_SECRETS_DIR/litellm_master_key
# Proveedores opcionales: openai_api_key, anthropic_api_key, openrouter_api_key.
LITELLM_PORT=4000
CODEX_PLANNER_MODELS=planner,coding
CODEX_BACKEND_MODELS=coding,fast
CODEX_TESTS_MODELS=fast,coding
CODEX_DOCS_MODELS=fast,coding

# ---------- Modelo local opcional ----------
OLLAMA_DATA_DIR=/home/CAMBIAR/.ollama
OLLAMA_PORT=11434

# ---------- Frenos ----------
MAX_RETRIES_PER_TASK=2
TASK_TIMEOUT_MINUTES=30
AI_AGENT_CONCURRENCY=1
MONTHLY_BUDGET_USD=0
AI_AUTONOMOUS_MODE=off
APPROVAL_TTL_MINUTES=10

# ---------- Bucle visual opcional ----------
STAGE_DIR=/home/CAMBIAR/workspace/stage
ARTEFACTOS_DIR=/home/CAMBIAR/workspace/artefactos
STAGE_PORT=8080
STAGE_BUILD_CMD=
STAGE_DIST_DIR=dist
UMBRAL_VISUAL=0.1
PW_VERSION=1.56.0

# ---------- WhatsApp opcional ----------
# cloud requiere archivos whatsapp_token y valores no secretos siguientes.
WHATSAPP_MODO=off
WHATSAPP_PHONE_ID=
WHATSAPP_DESTINO=
