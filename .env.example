# ============================================================
#  PLANTILLA DE VARIABLES DE ENTORNO
# ============================================================
#  Copiar a .env y completar con los valores reales:
#      cp .env.example .env && chmod 600 .env
#
#  .env está en .gitignore. NUNCA se commitea.
#  Si una clave se filtra: revocarla en la consola del
#  proveedor y generar una nueva. Borrarla del archivo no basta.
# ============================================================


# ---------- Telegram ----------
# Token que entrega BotFather al crear el bot (/newbot)
TELEGRAM_BOT_TOKEN=

# Tu chat_id numérico. CRÍTICO: sin esta allowlist cualquier
# desconocido que encuentre el bot obtiene shell en la VM.
# Se obtiene escribiéndole a @userinfobot en Telegram.
TELEGRAM_ALLOWED_CHAT_IDS=


# ---------- OpenClaw ----------
# Imagen oficial. En producción se debe reemplazar `latest` por una
# versión inmutable después de validar la instalación.
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:2026.7.1-2@sha256:8789721d2e9b24b780a1504b56deb4c6bd5c7dbf96a1dd117e7c45c2ed72c8ac
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_CONFIG_DIR=/home/CAMBIAR/.openclaw
AI_QUEUE_DIR=/home/CAMBIAR/.local/state/ai-devops/queue
AI_STATE_DIR=/home/CAMBIAR/.local/state/ai-devops
# Modelo local de respaldo sin tool-calling real — ver ADR-025
OLLAMA_DATA_DIR=/home/CAMBIAR/.ollama
# Zona horaria del contenedor (afecta logs y tareas programadas)
TZ=America/Lima


# ---------- GitHub ----------
# Personal Access Token de alcance MÍNIMO:
# solo el repo self-hosted-ai-devops, permisos de contenido y PRs.
# Nada de admin ni acceso a todos los repos.
GITHUB_TOKEN=
GITHUB_OWNER=marksato13
GITHUB_REPO=self-hosted-ai-devops
# Clon local del OTRO repositorio sobre el que trabajan los agentes.
# No apuntar aquí al repositorio de infraestructura salvo una prueba controlada.
AI_TARGET_REPO_DIR=/home/CAMBIAR/workspace/PROYECTO-OBJETIVO


# ---------- OmniRoute (gateway gratuito) ----------
# Unifica la suscripción de Codex y proveedores con capa gratuita.
# No requiere claves comerciales ni saldo de API para arrancar.
OMNIROUTE_JWT_SECRET=
OMNIROUTE_API_KEY_SECRET=
OMNIROUTE_STORAGE_ENCRYPTION_KEY=
OMNIROUTE_INITIAL_PASSWORD=

# Se crea desde Dashboard → Endpoints después del primer inicio.
# Es la única clave que Codex necesita para hablar con el gateway.
OMNIROUTE_API_KEY=

# Puerto solo local. El acceso remoto se hace por Tailscale.
OMNIROUTE_PORT=20128

# Cadenas opcionales de rutas ya creadas y comprobadas en OmniRoute. Se prueban
# en orden y separan con comas; una cadena vacía conserva los fallbacks seguros
# documentados. Ejemplo: combo/planner,cx/gpt-5.6-sol,oc/big-pickle
# Verificar antes con: ./scripts/verificar-rutas-modelos.sh
CODEX_PLANNER_MODELS=
CODEX_BACKEND_MODELS=
CODEX_TESTS_MODELS=
CODEX_DOCS_MODELS=


# ---------- Frenos (defensa contra bucles) ----------
# Tres límites, tal como hacen los proyectos de bucles autónomos
# (MartinLoop, fractal). Ver docs/decisiones.md — ADR-014

# Reintentos máximos por subtarea antes de cortar y avisar
MAX_RETRIES_PER_TASK=2

# Tiempo máximo por tarea. Un agente colgado se mata solo.
TASK_TIMEOUT_MINUTES=30

# Agentes por tanda. 1 evita superar el límite de conexiones de OmniRoute;
# subirlo solo después de comprobar el límite real del proveedor.
AI_AGENT_CONCURRENCY=1

# No permitir rutas de pago. Las cuotas gratuitas pueden agotarse;
# en ese caso la tarea se detiene en vez de generar cargos.
MONTHLY_BUDGET_USD=0

# off hasta verificar la allowlist desde una segunda cuenta (T027).
# on hace que el timer elija el primer issue abierto con etiqueta
# `agente:lista`, siempre que no haya otra tarea o PR de integración en vuelo.
AI_AUTONOMOUS_MODE=off

# Tiempo de validez del segundo paso de aprobación de un PR.
APPROVAL_TTL_MINUTES=10


# ============================================================
#  BUCLE VISUAL  (Fase 11 — opcional)
# ============================================================
#  Solo hace falta si el proyecto tiene interfaz web.
#  Ver docs/bucle-visual.md

# Dónde se vuelca el build de la rama que se está revisando.
# Se BORRA Y REESCRIBE en cada publicación: no guardar nada acá.
STAGE_DIR=/home/CAMBIAR/workspace/stage

# Dónde quedan las capturas, los diff y los informes de accesibilidad.
ARTEFACTOS_DIR=/home/CAMBIAR/workspace/artefactos

# Puerto local del stage. Solo 127.0.0.1; se publica con
# `tailscale serve`, nunca redirigiendo un puerto del router.
STAGE_PORT=8080

# Cómo compilar el proyecto antes de publicarlo.
# Vacío = sitio estático, se sirve tal cual.
# Ejemplo para una app JS:  npm ci && npm run build
STAGE_BUILD_CMD=
STAGE_DIST_DIR=dist

# % de píxeles que pueden cambiar sin considerarse regresión visual.
UMBRAL_VISUAL=0.1

# Versión de Playwright. Debe coincidir con infra/shotter/package.json.
PW_VERSION=1.56.0


# ---------- WhatsApp (opcional) ----------
# off      → recomendado. Telegram ya manda las imágenes.
# cloud    → API oficial de Meta. Ojo con la ventana de 24 h.
# openclaw → canal de OpenClaw. Usar un número SECUNDARIO.
# Ver docs/decisiones.md — ADR-016
WHATSAPP_MODO=off

# Solo si WHATSAPP_MODO=cloud
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_DESTINO=

# Solo si WHATSAPP_MODO=openclaw
# ⚠️ Confirmar la URL exacta en la documentación de OpenClaw.
OPENCLAW_NOTIFY_URL=
