# ============================================================
#  PLANTILLA DE VARIABLES DE ENTORNO
# ============================================================
#  Copiar a .env y completar con los valores reales:
#      cp .env.example .env && chmod 600 .env
#
#  .env está en .gitignore. NUNCA se commitea.
#  Si una clave se filtra: revocarla en la consola del
#  proveedor y generar una nueva. Borrarla del archivo no basta.
# ============================================================


# ---------- Telegram ----------
# Token que entrega BotFather al crear el bot (/newbot)
TELEGRAM_BOT_TOKEN=

# Tu chat_id numérico. CRÍTICO: sin esta allowlist cualquier
# desconocido que encuentre el bot obtiene shell en la VM.
# Se obtiene escribiéndole a @userinfobot en Telegram.
TELEGRAM_ALLOWED_CHAT_IDS=


# ---------- OpenClaw ----------
# Imagen Docker oficial. Confirmar el valor exacto en la
# documentación de OpenClaw antes de levantar el contenedor.
OPENCLAW_IMAGE=
OPENCLAW_PORT=3000
# Zona horaria del contenedor (afecta logs y tareas programadas)
TZ=America/Lima


# ---------- GitHub ----------
# Personal Access Token de alcance MÍNIMO:
# solo el repo self-hosted-ai-devops, permisos de contenido y PRs.
# Nada de admin ni acceso a todos los repos.
GITHUB_TOKEN=
GITHUB_OWNER=marksato13
GITHUB_REPO=self-hosted-ai-devops


# ---------- LiteLLM (gateway de modelos) ----------
# Todo el tráfico a modelos pasa por acá. Resuelve la
# incompatibilidad de API con Codex y aplica los topes de gasto.
# Ver docs/decisiones.md — ADR-010

# Clave maestra del gateway. Generar una al azar:
#   openssl rand -hex 32
LITELLM_MASTER_KEY=

# Contraseña de la base de datos donde LiteLLM guarda el gasto
# acumulado y las claves virtuales. También al azar.
POSTGRES_PASSWORD=


# ---------- Proveedores de modelos ----------
# Estas claves las consume LiteLLM, no Codex.
# Codex solo necesita LITELLM_MASTER_KEY.

# OpenAI — modelos `planner` y `reviewer`
OPENAI_API_KEY=

# DeepSeek — modelo `backend`
DEEPSEEK_API_KEY=

# Alibaba Bailian / DashScope — modelo `tester`
DASHSCOPE_API_KEY=

# Zhipu AI / Z.ai — modelo `docs`
ZHIPU_API_KEY=


# ---------- Frenos (defensa contra bucles) ----------
# Tres límites, tal como hacen los proyectos de bucles autónomos
# (MartinLoop, fractal). Ver docs/decisiones.md — ADR-014

# Reintentos máximos por subtarea antes de cortar y avisar
MAX_RETRIES_PER_TASK=2

# Tiempo máximo por tarea. Un agente colgado se mata solo.
TASK_TIMEOUT_MINUTES=30

# Tope de gasto mensual en USD.
# ⚠️ El que REALMENTE corta es max_budget en infra/litellm-config.yaml,
# aplicado por el gateway. Este valor es informativo para el orquestador.
MONTHLY_BUDGET_USD=20
